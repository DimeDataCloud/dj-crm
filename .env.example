# Copy to .env and fill in. The server refuses to start unless SESSION_SECRET,
# ADMIN_PASSWORD and ADMIN2_PASSWORD are set.

PORT=3007
DB_PATH=./data/djcrm.db

# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=replace-with-a-long-random-string

# First manager account, created on first boot only.
ADMIN_EMAIL=manager@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Second account, created on first boot only.
ADMIN2_EMAIL=get@dimedata.cloud
ADMIN2_PASSWORD=replace-with-a-second-strong-password

# Automation tick interval in minutes.
AUTOMATION_INTERVAL_MIN=15

# Set to 1 only when serving over plain http (local development).
INSECURE_COOKIE=0
